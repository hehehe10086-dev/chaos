# Copy this file to .env and fill in values. Never commit .env. Names only — no real values here.

# Upstash Redis (room state). Without these, local dev uses an in-memory store.
# On Vercel, the Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead — both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM: anthropic | openai | mock. Unset, or the matching key missing -> mock (works offline, costs nothing).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (fast / smart). Anthropic defaults: claude-haiku-4-5-20251001 /
# claude-sonnet-5-5. OpenAI defaults: gpt-6-luna / gpt-6.1-sol. Checked 2026-10-06.
MODEL_FAST=
MODEL_SMART=
# Max real LLM calls per day across all rooms (protects the public URL). Default 3000.
LLM_DAILY_CAP=

# Multiplies every scenario timing. 1 = a 10-minute game; 0.2 = 2 minutes (handy for testing).
TIME_SCALE=

# Set to "memory" to ignore Redis locally (npm run dev:offline does this for you).
CHAOS_STORE=
